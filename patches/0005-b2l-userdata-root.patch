diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index bb77c35..4a44d6b 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -897,7 +897,14 @@ bsd_init(void)
 #endif
 
 		bsd_init_kprintf("vfs_mountroot\n");
+#if defined(ARM64_BOARD_CONFIG_B2L)
+		extern void b2l_early_trace(const char *, ...);
+		b2l_early_trace("B2L ROOT: calling vfs_mountroot...\n");
+#endif
 		if (0 == (err = vfs_mountroot())) {
+#if defined(ARM64_BOARD_CONFIG_B2L)
+			b2l_early_trace("B2L ROOT: vfs_mountroot succeeded!\n");
+#endif
 			break;
 		}
 		rootdevice[0] = '\0';
@@ -915,6 +922,9 @@ bsd_init(void)
 		}
 #endif
 		printf("cannot mount root, errno = %d\n", err);
+#if defined(ARM64_BOARD_CONFIG_B2L)
+		b2l_early_trace("B2L ROOT: vfs_mountroot failed errno=%d\n", err);
+#endif
 	}
 
 	IOSecureBSDRoot(rootdevice);
