--- a/osfmk/arm64/sleh.c	2026-11-14 16:42:31
+++ b/osfmk/arm64/sleh.c	2026-11-14 17:09:24
@@ -2853,6 +2853,53 @@
 #endif /* __has_feature(ptrauth_calls) */
 
 
+#if defined(ARM64_BOARD_CONFIG_B2L)
+/*
+ * B2L: SCTLR_EL1.UCI is clear on this board (proc_reg.h), so EL0 cache maintenance by VA traps here.
+ * iOS's sys_icache_invalidate (libsystem_platform, the only EL0 cache maintenance in the whole 23G90 cache) runs
+ * IC IVAU without a DC CVAU first: enough on Apple cores (CTR_EL0.IDC=1), not on the Exynos 9820, where freshly
+ * written JIT code then ran stale (WebKit: 262 "undefined instruction" deaths on valid words, B1L-0202..0213).
+ * Each trapped line is done here through a per-CPU copy window onto its physical page: D-cache clean to PoU,
+ * then I-cache invalidate (the S10 I-caches do not alias with 16 KiB pages). An unmapped address has nothing to maintain.
+ */
+#define B2L_CACHE_LINE 64ULL
+static bool
+b2l_user_cache_op(arm_saved_state_t *state, uint64_t esr)
+{
+	uint32_t iss = (uint32_t)ESR_ISS(esr);
+	unsigned op0 = (iss >> 20) & 3, op2 = (iss >> 17) & 7, op1 = (iss >> 14) & 7;
+	unsigned crn = (iss >> 10) & 15, rt = (iss >> 5) & 31, crm = (iss >> 1) & 15;
+	/* SYS #3, C7, Cm, #1: IC IVAU (C5), DC CVAC (C10), DC CVAU (C11), DC CVAP (C12), DC CIVAC (C14) */
+	if (op0 != 1 || op1 != 3 || crn != 7 || op2 != 1 || (iss & 1) ||
+	    (crm != 5 && crm != 10 && crm != 11 && crm != 12 && crm != 14)) {
+		return false;
+	}
+	uint64_t va = rt == 31 ? 0 : get_saved_state_reg(state, rt);
+	va &= 0x00ffffffffffffffULL & ~(B2L_CACHE_LINE - 1);   /* EL0 top-byte tag */
+	pmap_paddr_t pa = va < MACH_VM_MAX_ADDRESS ? pmap_find_pa(vm_map_pmap(current_map()), va) : 0;
+	if (pa != 0) {
+		/* Not phystokv(): it panics on RAM outside its table (B1L-0218 froze when Safari's JIT page was there; panics
+		 * are not logged on this board). A per-CPU copy window maps any page, as b2l_unowned_cache_op does (0105). */
+		unsigned int index;
+		mp_disable_preemption();
+		index = pmap_map_cpu_windows_copy((ppnum_t)(pa >> PAGE_SHIFT), VM_PROT_READ,
+		    pmap_cache_attributes((ppnum_t)(pa >> PAGE_SHIFT)));
+		vm_offset_t kva = pmap_cpu_windows_copy_addr(cpu_number(), index) | (pa & PAGE_MASK);
+		if (crm == 5) {
+			InvalidatePoU_IcacheRegion(kva, B2L_CACHE_LINE);   /* cleans the D-cache line to PoU first */
+		} else if (crm == 11) {
+			CleanPoU_DcacheRegion(kva, B2L_CACHE_LINE);
+		} else {
+			FlushPoC_DcacheRegion(kva, B2L_CACHE_LINE);
+		}
+		pmap_unmap_cpu_windows_copy(index);
+		mp_enable_preemption();
+	}
+	add_saved_state_pc(state, 4);
+	return true;
+}
+#endif
+
